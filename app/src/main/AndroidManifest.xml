<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.yourapp.stavelectroset">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>

    <application
        android:name=".App"
        android:label="@string/app_name"
        android:icon="@drawable/stavelectroset_ic"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Material3.DayNight.NoActionBar">

        <meta-data
            android:name="com.yandex.maps.apikey"
            android:value="@string/yandex_mapkit_api_key"/>


        <!-- экран детали новости не должен быть доступен извне -->
        <activity
            android:name=".feature.news.ui.NewsDetailActivity"
            android:exported="false" />

        <!-- лаунчер-активити должна быть exported=true -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".feature.news.auth.data.local.ui.RegisterActivity"/>
        <activity android:name=".feature.news.auth.data.local.ui.ProfileActivity"/>
        <activity android:name=".feature.news.auth.data.local.ui.LoginActivity"/>
        <activity
            android:name=".feature.news.admin.ui.AdminPanelActivity"
            android:label="Админ-панель"
            android:exported="false" />
        <activity
            android:name=".web.WebPageActivity"
            android:exported="false" />
        <activity
            android:name=".feature.news.consumers.RepairsActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".feature.news.consumers.ConsumersMapActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:label="@string/app_name"/>
        <activity
            android:name=".feature.news.admin.ui.AdminUsersActivity"
            android:exported="false" />
        <activity
            android:name=".feature.news.admin.ui.AdminCertificatesActivity"
            android:exported="false" />


    </application>
</manifest>
