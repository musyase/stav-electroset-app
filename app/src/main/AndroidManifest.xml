<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:name=".App"
        android:label="@string/app_name"
        android:icon="@drawable/stavelectroset_ic"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Stavelectroset"
        tools:targetApi="33">

        <meta-data
            android:name="com.yandex.maps.apikey"
            android:value="@string/yandex_mapkit_api_key" />

        <activity
            android:name=".feature.news.ui.NewsDetailActivity"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Auth -->
        <activity
            android:name=".feature.news.auth.data.local.ui.RegisterActivity"
            android:exported="false" />

        <activity
            android:name=".feature.news.auth.data.local.ui.LoginActivity"
            android:exported="false" />

        <activity
            android:name=".feature.news.auth.data.local.ui.ProfileActivity"
            android:exported="false" />

        <activity
            android:name=".feature.news.auth.data.local.ui.ResetPasswordActivity"
            android:exported="true"
            android:launchMode="singleTask">

            <!-- 1) custom scheme -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="stavelectroset"
                    android:host="auth"
                    android:path="/callback" />
            </intent-filter>

            <!-- 2) https supabase verify link (ВАЖНО: host = твой projectRef.supabase.co) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="ajwtlftmwnjygdyhsjlh.supabase.co"
                    android:pathPrefix="/auth/v1/verify" />
            </intent-filter>

        </activity>

        <!-- Web -->
        <activity
            android:name=".web.WebPageActivity"
            android:exported="false" />

        <activity
            android:name=".feature.news.auth.data.local.ui.AuthCallbackActivity"
            android:exported="true"
            android:launchMode="singleTask">

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="stavelectroset"
                    android:host="auth"
                    android:path="/callback" />
            </intent-filter>
        </activity>

        <!-- Consumers -->
        <activity
            android:name=".feature.news.consumers.RepairsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".feature.news.consumers.ConsumersMapActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:label="@string/app_name" />

        <activity
            android:name=".feature.news.auth.data.local.ui.RequestActivity"
            android:exported="false" />

        <activity
            android:name=".feature.news.auth.data.local.ui.ComplaintActivity"
            android:exported="false" />

        <activity
            android:name=".feature.news.auth.data.local.ui.RequestCreateActivity"
            android:exported="false" />

        <activity
            android:name=".feature.news.auth.data.local.ui.ComplaintCreateActivity"
            android:exported="false" />

        <activity
            android:name=".feature.news.auth.data.local.ui.AdminDashboardActivity"
            android:exported="false" />

        <activity
            android:name=".feature.news.auth.data.local.ui.RoleManagementActivity"
            android:exported="false" />

        <activity
            android:name=".feature.news.auth.data.local.ui.AdminRequestsActivity"
            android:exported="false" />

        <activity
            android:name=".feature.news.auth.data.local.ui.AdminComplaintsActivity"
            android:exported="false" />

        <activity
            android:name=".feature.news.auth.data.local.ui.AttachmentViewerActivity"
            android:exported="false" />

        <activity
            android:name=".feature.news.auth.data.local.ui.RequestDetailsActivity"
            android:exported="false" />

        <activity
            android:name=".feature.news.auth.data.local.ui.ComplaintDetailsActivity"
            android:exported="false" />

        <activity
            android:name=".feature.news.auth.data.local.ui.ProfileSettingsActivity"
            android:exported="false" />

        <activity
            android:name=".feature.news.auth.data.local.ui.AdminInfoLettersActivity"
            android:exported="false" />

        <activity
            android:name=".feature.news.auth.data.local.ui.InfoLettersActivity"
            android:exported="false" />

    </application>
</manifest>