<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg">

    <!-- Карта -->
    <com.yandex.mapkit.mapview.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Floating top bar -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding_horizontal"
        android:layout_marginTop="@dimen/space_12"
        android:layout_marginEnd="@dimen/screen_padding_horizontal"
        android:elevation="6dp"
        app:cardBackgroundColor="@color/app_surface"
        app:cardCornerRadius="@dimen/radius_lg"
        app:strokeColor="@color/app_outline"
        app:strokeWidth="@dimen/stroke_thin">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.App.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/toolbar_height"
            android:background="@android:color/transparent"
            app:title="Карта филиалов"
            app:titleCentered="true" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Floating map controls -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/fabGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="84dp"
        android:layout_marginEnd="@dimen/screen_padding_horizontal"
        android:elevation="6dp"
        app:cardBackgroundColor="@color/app_surface"
        app:cardCornerRadius="@dimen/radius_lg"
        app:strokeColor="@color/app_outline"
        app:strokeWidth="@dimen/stroke_thin">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_8">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabMyLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Моё местоположение"
                app:backgroundTint="@color/app_surface"
                app:fabSize="mini"
                app:srcCompat="@drawable/ic_my_location"
                app:tint="@color/app_text_primary" />

            <Space
                android:layout_width="0dp"
                android:layout_height="@dimen/space_8" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabZoomIn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Приблизить"
                app:backgroundTint="@color/app_surface"
                app:fabSize="mini"
                app:srcCompat="@drawable/ic_zoom_in"
                app:tint="@color/app_text_primary" />

            <Space
                android:layout_width="0dp"
                android:layout_height="@dimen/space_8" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabZoomOut"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Отдалить"
                app:backgroundTint="@color/app_surface"
                app:fabSize="mini"
                app:srcCompat="@drawable/ic_zoom_out"
                app:tint="@color/app_text_primary" />
        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Floating bottom sheet -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/branchSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="@dimen/space_12"
        android:layout_marginEnd="@dimen/space_12"
        android:layout_marginBottom="92dp"
        android:elevation="12dp"
        app:behavior_hideable="true"
        app:behavior_peekHeight="72dp"
        app:cardBackgroundColor="@color/app_surface"
        app:cardCornerRadius="@dimen/bottom_sheet_corner_radius"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:strokeColor="@color/app_outline"
        app:strokeWidth="@dimen/stroke_thin">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_20"
            android:paddingTop="@dimen/space_12"
            android:paddingEnd="@dimen/space_20"
            android:paddingBottom="@dimen/space_20">

            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_sheet_drag_handle" />

            <TextView
                android:id="@+id/sheetTitle"
                style="@style/TextAppearance.App.TitleMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:text="Название филиала" />

            <TextView
                android:id="@+id/sheetAddress"
                style="@style/TextAppearance.App.BodySecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:text="Адрес" />

            <TextView
                android:id="@+id/sheetDesc"
                style="@style/TextAppearance.App.BodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_10"
                android:text="Описание"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:orientation="horizontal"
                android:weightSum="4">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRoute"
                    style="@style/Widget.App.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:text="Маршрут" />

                <Space
                    android:layout_width="@dimen/space_8"
                    android:layout_height="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCall"
                    style="@style/Widget.App.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Звонок" />

                <Space
                    android:layout_width="@dimen/space_8"
                    android:layout_height="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSite"
                    style="@style/Widget.App.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Сайт" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Bottom navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        style="@style/Widget.App.BottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_nav_height"
        android:layout_gravity="bottom"
        android:layout_marginStart="@dimen/bottom_nav_horizontal_margin"
        android:layout_marginEnd="@dimen/bottom_nav_horizontal_margin"
        android:layout_marginBottom="@dimen/bottom_nav_bottom_margin"
        android:elevation="8dp"
        app:menu="@menu/menu_bottom_nav" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>