<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.Stavelectroset" parent="Theme.Material3.Light.NoActionBar">

        <!-- БАЗОВЫЕ ФОНЫ / SURFACE -->
        <item name="android:windowBackground">@color/app_bg</item>
        <item name="android:colorBackground">@color/app_bg</item>

        <item name="colorSurface">@color/app_surface</item>
        <item name="colorSurfaceVariant">@color/app_surface_variant</item>
        <item name="colorOnSurface">@color/app_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/app_text_secondary</item>

        <!-- PRIMARY / BRAND -->
        <item name="colorPrimary">@color/app_primary</item>
        <item name="colorOnPrimary">@color/app_on_primary</item>
        <item name="colorPrimaryContainer">@color/app_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/app_on_primary_container</item>

        <!-- SECONDARY -->
        <item name="colorSecondary">@color/app_secondary</item>
        <item name="colorOnSecondary">@color/app_on_secondary</item>
        <item name="colorSecondaryContainer">@color/app_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/app_on_secondary_container</item>

        <!-- ERROR / OUTLINE -->
        <item name="colorError">@color/app_error</item>
        <item name="colorOnError">@color/app_on_error</item>
        <item name="colorOutline">@color/app_outline</item>

        <!-- СИСТЕМНЫЕ БАРЫ -->
        <item name="android:statusBarColor">@color/app_surface</item>
        <item name="android:navigationBarColor">@color/app_surface</item>

        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>

        <!-- ОТКЛЮЧАЕМ AUTO FORCE DARK -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>

    </style>

    <style name="Theme.Stavelectroset" parent="Base.Theme.Stavelectroset" />

</resources>